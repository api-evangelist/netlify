{
  "opencollection": "1.0.0",
  "info": {
    "name": "Netlify Netlify's API documentation accessToken Asset API",
    "version": "2.33.1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://app.netlify.com/authorize",
      "credentials": {
        "clientId": "{{clientId}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Asset",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listSiteAssets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.netlify.com/api/v1/sites/:site_id/assets",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "createSiteAsset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.netlify.com/api/v1/sites/:site_id/assets",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "size",
                "value": "",
                "type": "query"
              },
              {
                "name": "content_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "visibility",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "getSiteAssetInfo",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.netlify.com/api/v1/sites/:site_id/assets/:asset_id",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "asset_id",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "updateSiteAsset",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.netlify.com/api/v1/sites/:site_id/assets/:asset_id",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "asset_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "deleteSiteAsset",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.netlify.com/api/v1/sites/:site_id/assets/:asset_id",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "asset_id",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}