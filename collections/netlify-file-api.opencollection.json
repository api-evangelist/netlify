{
  "opencollection": "1.0.0",
  "info": {
    "name": "Netlify Netlify's API documentation accessToken File API",
    "version": "2.33.1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://app.netlify.com/authorize",
      "credentials": {
        "clientId": "{{clientId}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "File",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listSiteFiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.netlify.com/api/v1/sites/:site_id/files",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "getSiteFileByPathName",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.netlify.com/api/v1/sites/:site_id/files/:file_path",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "file_path",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "uploadDeployFile",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.netlify.com/api/v1/deploys/:deploy_id/files/:path",
            "params": [
              {
                "name": "deploy_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "path",
                "value": "",
                "type": "path"
              },
              {
                "name": "size",
                "value": "",
                "type": "query"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}