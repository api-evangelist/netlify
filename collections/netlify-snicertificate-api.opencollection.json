{
  "opencollection": "1.0.0",
  "info": {
    "name": "Netlify Netlify's API documentation accessToken sniCertificate API",
    "version": "2.33.1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://app.netlify.com/authorize",
      "credentials": {
        "clientId": "{{clientId}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "sniCertificate",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "showSiteTLSCertificate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.netlify.com/api/v1/sites/:site_id/ssl",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "provisionSiteTLSCertificate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.netlify.com/api/v1/sites/:site_id/ssl",
            "params": [
              {
                "name": "site_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "certificate",
                "value": "",
                "type": "query"
              },
              {
                "name": "key",
                "value": "",
                "type": "query"
              },
              {
                "name": "ca_certificates",
                "value": "",
                "type": "query"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}