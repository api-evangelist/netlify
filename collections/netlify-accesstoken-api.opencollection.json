{
  "opencollection": "1.0.0",
  "info": {
    "name": "Netlify Netlify's API documentation accessToken API",
    "version": "2.33.1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://app.netlify.com/authorize",
      "credentials": {
        "clientId": "{{clientId}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "accessToken",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "exchangeTicket",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.netlify.com/api/v1/oauth/tickets/:ticket_id/exchange",
            "params": [
              {
                "name": "ticket_id",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}